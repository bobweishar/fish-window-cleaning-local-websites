# Set this to the final production origin before deployment.
PUBLIC_SITE_URL=https://chicagolandwindowcleaning.com

# Optional. Use GTM for a managed tag stack, or GA4 for direct measurement.
# If both are set, GTM takes precedence so GA4 events are not counted twice.
PUBLIC_GTM_ID=GTM-XXXXXXX
PUBLIC_GA4_ID=G-XXXXXXXXXX
