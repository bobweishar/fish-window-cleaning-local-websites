---
import { estimateLink, site } from '../data/site';
interface Props { source: string; heading?: string; copy?: string; }
const {
  source,
  heading = 'Ready for clean windows?',
  copy = 'Tell us what needs cleaning.',
} = Astro.props;
---

<section class="estimate-band">
  <div>
    <h2>{heading}</h2>
    <p>{copy}</p>
  </div>
  <div class="button-row">
    <a class="button button--light" href={estimateLink(source)} data-track="estimate_click" data-location={source}>Request a free estimate</a>
    <a class="text-link text-link--light" href={site.phoneHref} data-track="phone_click" data-location={source}>Call {site.phoneDisplay}</a>
  </div>
</section>
