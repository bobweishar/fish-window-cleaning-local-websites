---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="footer-main">
    <div>
      <img class="footer-logo" src="/images/brand/fish-logo-square.jpg" width="96" height="96" alt="FISH Window Cleaning" />
      <p>Locally owned and operated.</p>
    </div>
    <div>
      <h2>Services</h2>
      <a href="/services/residential-window-cleaning/">Residential window cleaning</a>
      <a href="/services/commercial-window-cleaning/">Commercial window cleaning</a>
      <a href="/services/gutter-cleaning/">Gutter cleaning</a>
      <a href="/services/pressure-washing/">Pressure washing</a>
      <a href="/service-areas/hinsdale-il/">Window cleaning in Hinsdale</a>
      <a href="/team/">Meet the local team</a>
    </div>
    <div>
      <h2>Contact</h2>
      <a href={site.phoneHref}>{site.phoneDisplay}</a>
      <address>{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</address>
      <a href={site.officialPage}>Official FISH franchise page</a>
    </div>
  </div>
  <div class="footer-base">
    <p>Independent local marketing site for the FISH Window Cleaning franchise serving Chicago’s western and southern suburbs.</p>
    <p>FISH Window Cleaning® is a registered trademark of its respective owner.</p>
  </div>
</footer>
