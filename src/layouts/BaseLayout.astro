---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { estimateLink, googleProfile, site } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  additionalSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image = '/images/jobs/4305.jpg', noindex = false, additionalSchema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const homeUrl = new URL('/', Astro.site);
const businessId = new URL('/#local-business', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const pageId = `${canonical.href}#webpage`;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const extraSchemaNodes = Array.isArray(additionalSchema) ? additionalSchema : [additionalSchema];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['HomeAndConstructionBusiness', 'LocalBusiness'],
      '@id': businessId,
      name: site.name,
      alternateName: site.shortName,
      description: 'Locally owned FISH Window Cleaning franchise serving Chicago’s western and southern suburbs.',
      image: imageUrl.href,
      logo: new URL('/images/brand/fish-logo.jpg', Astro.site).href,
      telephone: '+1-630-757-3474',
      url: homeUrl.href,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.state,
        postalCode: site.address.zip,
        addressCountry: 'US',
      },
      areaServed: site.towns.map((name) => ({ '@type': 'City', name, addressRegion: 'IL' })),
      sameAs: [site.officialPage, googleProfile.url],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Local cleaning services',
        itemListElement: [
          'Residential window cleaning',
          'Commercial window cleaning',
          'Gutter cleaning',
          'Pressure washing',
          'Awning cleaning',
          'Screen cleaning',
          'Skylight cleaning',
          'Exterior light-fixture cleaning',
        ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: homeUrl.href,
      name: site.name,
      publisher: { '@id': businessId },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': pageId,
      url: canonical.href,
      name: title,
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': businessId },
      primaryImageOfPage: { '@type': 'ImageObject', url: imageUrl.href },
      inLanguage: 'en-US',
    },
    ...extraSchemaNodes.map((node) => node['@type'] === 'Service' ? { provider: { '@id': businessId }, ...node } : node),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#e51837" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/brand/fish-logo-square.jpg" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1'} />
    <meta name="googlebot" content={noindex ? 'noindex,follow' : 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1'} />
    <link rel="alternate" type="text/plain" href={new URL('/llms.txt', Astro.site)} title="AI-readable site guide" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var firstScript = document.getElementsByTagName('script')[0];
        var tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
        firstScript.parentNode.insertBefore(tag, firstScript);
      </script>
    )}
  </head>
  <body>
    {gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div class="mobile-actions" aria-label="Quick contact actions">
      <a href={site.phoneHref} data-track="phone_click" data-location="mobile-bar">Call now</a>
      <a href={estimateLink('mobile-bar')} data-track="estimate_click" data-location="mobile-bar">Free estimate</a>
    </div>
    <script is:inline>
      document.querySelectorAll('[data-track]').forEach(function (link) {
        link.addEventListener('click', function () {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: link.dataset.track,
            link_location: link.dataset.location || 'unknown',
            page_path: window.location.pathname,
            destination_url: link.href,
          });
        });
      });

      document.querySelectorAll('[data-compare]').forEach(function (comparison) {
        var range = comparison.querySelector('input[type="range"]');
        if (!range) return;

        function updateComparison() {
          comparison.classList.add('is-interacting');
          comparison.style.setProperty('--split', range.value + '%');
        }

        range.addEventListener('input', updateComparison);
        range.addEventListener('pointerdown', function () { comparison.classList.add('is-interacting'); });
        range.addEventListener('keydown', function () { comparison.classList.add('is-interacting'); });
      });

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -48px' });
      document.querySelectorAll('[data-reveal]').forEach(function (el) { observer.observe(el); });
    </script>
  </body>
</html>
