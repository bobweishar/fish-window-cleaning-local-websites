---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateBand from '../components/EstimateBand.astro';
import { estimateLink, site } from '../data/site';

const teamSchema = {
  '@type': 'AboutPage',
  '@id': new URL('/team/#about', Astro.site).href,
  name: 'Meet the local FISH Window Cleaning team',
  description: 'The owner, crew, and community story behind the locally operated FISH Window Cleaning team serving Hinsdale.',
  mainEntity: { '@id': new URL('/hinsdale/#local-business', Astro.site).href },
};
---

<BaseLayout
  title="Meet the Local Team | FISH Window Cleaning Hinsdale"
  description="Meet the local FISH Window Cleaning owner and crew serving Hinsdale, and learn how this locally operated franchise gives back."
  image="/images/jobs/3800.jpg"
  additionalSchema={teamSchema}
>
  <section class="team-hero">
    <div class="team-hero-copy">
      <p class="location-line">The people behind the red shirts</p>
      <h1>A local crew—not a mystery middleman.</h1>
      <p class="team-hero-lede">The people who answer the call, walk the property, and clean the glass are part of the same local operation serving Hinsdale.</p>
      <div class="button-row">
        <a class="button" href={estimateLink('team-hero')} data-track="estimate_click" data-location="team-hero">Request a free estimate</a>
        <a class="button button--outline" href={site.phoneHref} data-track="phone_click" data-location="team-hero">Call the local team</a>
      </div>
    </div>
    <div class="team-hero-gallery" aria-label="Photos of the local FISH Window Cleaning crew">
      <figure class="team-action-photo">
        <img src="/images/jobs/4280.jpg" width="512" height="720" alt="Local FISH technician cleaning windows at a Chicago-area commercial property" />
        <figcaption>Out on the local route</figcaption>
      </figure>
      <figure class="team-group-photo team-group-photo--top">
        <img src="/images/jobs/3800.jpg" width="310" height="236" alt="Members of the local FISH Window Cleaning team together in red uniforms" />
        <figcaption>The crew behind the clean</figcaption>
      </figure>
      <figure class="team-group-photo team-group-photo--bottom">
        <img src="/images/jobs/3962.jpg" width="310" height="210" alt="The local FISH Window Cleaning crew gathered outside" />
        <figcaption>Local people. Local accountability.</figcaption>
      </figure>
    </div>
  </section>

  <section class="team-intro section">
    <div class="team-intro-heading" data-reveal>
      <p class="story-marker">The local story</p>
      <h2>A local Chicago chapter, built close to home.</h2>
    </div>
    <div class="team-intro-copy" data-reveal>
      <p class="story-lede">FISH welcomed Dave Weishar as the owner of this local franchise in <a href="https://www.glassdoor.co.in/Updates/Fish-Window-Cleaning-Company-Updates-E383461_P2.htm" target="_blank" rel="noopener noreferrer">early 2025</a>.</p>
      <p>Today, the operation handles Hinsdale residential visits, downtown storefronts, offices, recurring routes, and seasonal exterior work through one local team.</p>
    </div>
  </section>

  <section class="leader-section section section--mist">
    <div class="leader-portrait" data-reveal>
      <img src="/images/dave-weishar.jpg" width="288" height="214" alt="Dave Weishar, owner of the local FISH Window Cleaning franchise" loading="lazy" />
      <div><strong>Dave Weishar</strong><span>Local owner</span></div>
    </div>
    <div class="leader-copy" data-reveal>
      <p class="story-marker">Local ownership</p>
      <h2>One owner to call. One team responsible.</h2>
      <p>Dave leads the franchise alongside business partners and an operations team. Your estimate and service stay with the same local operation.</p>
      <p>The crew arrives in FISH uniforms, follows the local franchise’s professional standards, and works across the same communities named on this site.</p>
      <a class="text-link" href={site.phoneHref} data-track="phone_click" data-location="team-owner">Call {site.phoneDisplay} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="crew-work section" aria-labelledby="crew-work-heading">
    <div class="section-heading" data-reveal>
      <h2 id="crew-work-heading">Meet them where it counts: on the job.</h2>
    </div>
    <div class="crew-work-grid">
      <figure class="crew-work-grid__home" data-reveal>
        <img src="/images/jobs/4312.jpg" width="530" height="720" alt="Local FISH technician cleaning second-story windows on a brick home" loading="lazy" />
        <figcaption><strong>Residential crew</strong><span>Careful work around the whole home</span></figcaption>
      </figure>
      <figure data-reveal>
        <img src="/images/jobs/4542.jpg" width="576" height="720" alt="Local FISH technician cleaning a storefront entrance" loading="lazy" />
        <figcaption><strong>Commercial route</strong><span>Storefront glass and entries</span></figcaption>
      </figure>
      <figure data-reveal>
        <img src="/images/jobs/4260.jpg" width="476" height="720" alt="Local FISH technician cleaning an exterior coach light" loading="lazy" />
        <figcaption><strong>Exterior details</strong><span>The jobs that make a property feel finished</span></figcaption>
      </figure>
      <figure class="crew-work-grid__wide" data-reveal>
        <img src="/images/jobs/4305.jpg" width="720" height="567" alt="Two local FISH Window Cleaning vans parked on a leafy suburban street" loading="lazy" />
        <figcaption><strong>In the neighborhood</strong><span>Serving Hinsdale homes and businesses</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="community-story section section--ink">
    <div class="community-story-copy" data-reveal>
      <p class="story-marker">More than clean windows</p>
      <h2>The cause is personal here.</h2>
      <p>For Breast Cancer Awareness Month, Dave and the team donated a full-house window cleaning to a local survivor through a connection with the Andrew Weishar Foundation. Breast cancer has directly affected members of the local leadership team and their families, turning the work into more than a one-day promotion.</p>
      <p>The foundation’s “pay it forward” mission is part of this family’s Chicago story. The local franchise proudly supports that work while continuing to show up for the neighborhoods it serves.</p>
      <div class="community-links">
        <a class="button button--light" href="https://www.weish4ever.org/" target="_blank" rel="noopener noreferrer">Visit Weish4Ever <span aria-hidden="true">↗</span></a>
        <a class="text-link text-link--light" href={`${site.officialPage}about/giving-back`}>Read the local giving-back story <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="community-story-photo" data-reveal>
      <img src="/images/jobs/3772.jpg" width="174" height="310" alt="Members of the local FISH franchise gathered for a community event" loading="lazy" />
      <figcaption>Local team. Family roots. A reason to give back.</figcaption>
    </figure>
  </section>

  <section class="team-standards section">
    <div class="team-standards-intro" data-reveal>
      <p class="story-marker">What local should feel like</p>
      <h2>Recognizable at the door. Accountable after the job.</h2>
    </div>
    <ol class="team-standards-list">
      <li data-reveal><span>01</span><div><h3>Easy to identify</h3><p>Uniformed professionals and branded vehicles make it clear who has arrived.</p></div></li>
      <li data-reveal><span>02</span><div><h3>Careful in your space</h3><p>Shoe covers, protective pads, and cleanup practices help protect the property while the team works.</p></div></li>
      <li data-reveal><span>03</span><div><h3>Built for repeat trust</h3><p>One-time residential visits and recurring commercial routes are handled by the same accountable local operation.</p></div></li>
    </ol>
  </section>

  <EstimateBand source="team-close" heading="Ready to meet the crew at your place?" />
</BaseLayout>
