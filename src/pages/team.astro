---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateBand from '../components/EstimateBand.astro';
import { estimateLink, site } from '../data/site';

const teamSchema = {
  '@type': 'AboutPage',
  '@id': new URL('/team/#about', Astro.site).href,
  name: 'Meet the local FISH Window Cleaning team',
  description: 'The owner, crew, and community story behind the locally operated FISH Window Cleaning team serving Hinsdale.',
  mainEntity: { '@id': new URL('/hinsdale/#local-business', Astro.site).href },
};
---

<BaseLayout
  title="Meet the Local Team | FISH Window Cleaning Hinsdale"
  description="Meet the local FISH Window Cleaning owner and crew serving Hinsdale, and learn how this locally operated franchise gives back."
  image="/images/jobs/3800.jpg"
  additionalSchema={teamSchema}
>
  <section class="team-hero">
    <div class="team-hero-copy">
      <h1>Meet the crew that does the work.</h1>
      <p class="team-hero-lede">The same local business answers the phone, estimates the job, and cleans the glass.</p>
      <div class="button-row">
        <a class="button" href={estimateLink('team-hero')} data-track="estimate_click" data-location="team-hero">Request a free estimate</a>
        <a class="button button--outline" href={site.phoneHref} data-track="phone_click" data-location="team-hero">Call the local team</a>
      </div>
    </div>
    <div class="team-hero-gallery" aria-label="Photos of the local FISH Window Cleaning crew">
      <figure class="team-action-photo">
        <img src="/images/jobs/4280.jpg" width="512" height="720" alt="Local FISH technician cleaning windows at a Chicago-area commercial property" />
        <figcaption>On the route</figcaption>
      </figure>
      <figure class="team-group-photo team-group-photo--top">
        <img src="/images/jobs/3800.jpg" width="310" height="236" alt="Members of the local FISH Window Cleaning team together in red uniforms" />
        <figcaption>The crew</figcaption>
      </figure>
      <figure class="team-group-photo team-group-photo--bottom">
        <img src="/images/jobs/3962.jpg" width="310" height="210" alt="The local FISH Window Cleaning crew gathered outside" />
        <figcaption>At the shop</figcaption>
      </figure>
    </div>
  </section>

  <section class="team-intro section">
    <div class="team-intro-heading" data-reveal>
      <h2>Dave took over the franchise in early 2025.</h2>
    </div>
    <div class="team-intro-copy" data-reveal>
      <p class="story-lede">Today the team handles homes, downtown storefronts, offices, recurring routes, and seasonal exterior work.</p>
    </div>
  </section>

  <section class="leader-section section section--mist">
    <div class="leader-portrait" data-reveal>
      <img src="/images/dave-weishar.jpg" width="288" height="214" alt="Dave Weishar, owner of the local FISH Window Cleaning franchise" loading="lazy" />
      <div><strong>Dave Weishar</strong><span>Local owner</span></div>
    </div>
    <div class="leader-copy" data-reveal>
      <h2>One owner to call. One team responsible.</h2>
      <p>Dave leads the franchise with business partners and an operations team. Your estimate and service stay with the same local business.</p>
      <p>The crew arrives in FISH uniforms and follows the franchise’s service standards.</p>
      <a class="text-link" href={site.phoneHref} data-track="phone_click" data-location="team-owner">Call {site.phoneDisplay} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="crew-work section" aria-labelledby="crew-work-heading">
    <div class="section-heading" data-reveal>
      <h2 id="crew-work-heading">See the crew at work.</h2>
    </div>
    <div class="crew-work-grid">
      <figure class="crew-work-grid__home" data-reveal>
        <img src="/images/jobs/4312.jpg" width="530" height="720" alt="Local FISH technician cleaning second-story windows on a brick home" loading="lazy" />
        <figcaption><strong>Residential work</strong><span>Upper-story windows</span></figcaption>
      </figure>
      <figure data-reveal>
        <img src="/images/jobs/4542.jpg" width="576" height="720" alt="Local FISH technician cleaning a storefront entrance" loading="lazy" />
        <figcaption><strong>Commercial work</strong><span>Storefront glass and entries</span></figcaption>
      </figure>
      <figure data-reveal>
        <img src="/images/jobs/4260.jpg" width="476" height="720" alt="Local FISH technician cleaning an exterior coach light" loading="lazy" />
        <figcaption><strong>Exterior details</strong><span>Coach lights and finishing work</span></figcaption>
      </figure>
      <figure class="crew-work-grid__wide" data-reveal>
        <img src="/images/jobs/4305.jpg" width="720" height="567" alt="Two local FISH Window Cleaning vans parked on a leafy suburban street" loading="lazy" />
        <figcaption><strong>On the road</strong><span>Serving homes and businesses</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="community-story section section--ink">
    <div class="community-story-copy" data-reveal>
      <h2>Why the team gives back.</h2>
      <p>For Breast Cancer Awareness Month, Dave and the team donated a full-house window cleaning to a local survivor through the Andrew Weishar Foundation. Breast cancer has affected members of the leadership team and their families.</p>
      <p>The franchise supports the foundation’s pay-it-forward mission and the Chicago families it serves.</p>
      <div class="community-links">
        <a class="button button--light" href="https://www.weish4ever.org/" target="_blank" rel="noopener noreferrer">Visit Weish4Ever <span aria-hidden="true">↗</span></a>
        <a class="text-link text-link--light" href={`${site.officialPage}about/giving-back`}>Read the FISH giving-back story <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="community-story-photo" data-reveal>
      <img src="/images/jobs/3772.jpg" width="174" height="310" alt="Members of the local FISH franchise gathered for a community event" loading="lazy" />
      <figcaption>Supporting local families through Weish4Ever.</figcaption>
    </figure>
  </section>

  <section class="team-standards section">
    <div class="team-standards-intro" data-reveal>
      <h2>Recognizable at the door. Accountable after the job.</h2>
    </div>
    <ol class="team-standards-list">
      <li data-reveal><span>01</span><div><h3>Easy to recognize</h3><p>Uniforms and branded vehicles make it clear who has arrived.</p></div></li>
      <li data-reveal><span>02</span><div><h3>Careful inside</h3><p>Shoe covers, protective pads, and cleanup practices help protect your home.</p></div></li>
      <li data-reveal><span>03</span><div><h3>Accountable after the job</h3><p>Residential visits and commercial routes stay with the same local business.</p></div></li>
    </ol>
  </section>

  <EstimateBand source="team-close" heading="Request an estimate from the local team." />
</BaseLayout>
