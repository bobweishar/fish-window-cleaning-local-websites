---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateBand from '../components/EstimateBand.astro';
import { estimateLink, site } from '../data/site';

const teamSchema = {
  '@type': 'AboutPage',
  '@id': new URL('/team/#about', Astro.site).href,
  name: 'About the local FISH Window Cleaning crew',
  description: 'Meet the owner and local crew behind FISH Window Cleaning in Hinsdale, Illinois.',
  mainEntity: { '@id': new URL('/hinsdale/#local-business', Astro.site).href },
};
---

<BaseLayout
  title="About Da Local Crew | FISH Window Cleaning Hinsdale"
  description="Meet Dave and the local FISH Window Cleaning crew serving Hinsdale homes, storefronts, gutters, and more."
  image="/images/jobs/3800.jpg"
  additionalSchema={teamSchema}
>
  <section class="team-hero">
    <div class="team-hero-copy">
      <h1 class="team-hero-title"><span><em>Da</em> windows.</span><span><em>Da</em> gutters.</span><span><em>Da</em> local crew.</span></h1>
      <p class="team-hero-lede">Chicago-area people who answer the phone, show up in the red vans, and do the work.</p>
      <div class="button-row">
        <a class="button" href={estimateLink('team-hero')} data-track="estimate_click" data-location="team-hero">Get a free quote</a>
        <a class="button button--outline" href={site.phoneHref} data-track="phone_click" data-location="team-hero">Call da crew</a>
      </div>
    </div>
    <div class="team-hero-gallery" aria-label="Photos of the local FISH Window Cleaning crew">
      <figure class="team-action-photo">
        <img src="/images/jobs/4280.webp" width="512" height="720" alt="Local FISH technician cleaning windows at a Chicago-area commercial property" fetchpriority="high" decoding="async" />
        <figcaption>Da route</figcaption>
      </figure>
      <figure class="team-group-photo team-group-photo--top">
        <img src="/images/jobs/3800.webp" width="310" height="236" alt="Members of the local FISH Window Cleaning team together in red uniforms" decoding="async" />
        <figcaption>Da crew</figcaption>
      </figure>
      <figure class="team-group-photo team-group-photo--bottom">
        <img src="/images/jobs/3962.webp" width="310" height="210" alt="The local FISH Window Cleaning crew gathered outside" decoding="async" />
        <figcaption>Da shop</figcaption>
      </figure>
    </div>
  </section>

  <section class="team-intro section">
    <div class="team-intro-heading" data-reveal>
      <h2>Dave started it. The crew makes it shine.</h2>
    </div>
    <div class="team-intro-copy" data-reveal>
      <p class="story-lede">This local FISH business opened in early 2025. Today, the team cleans homes, storefronts, offices, gutters, and exterior surfaces across the western suburbs.</p>
      <p>No mystery call center. Just a local team that picks up, shows up, and owns the job.</p>
    </div>
  </section>

  <section class="community-story section section--ink">
    <div class="community-story-copy" data-reveal>
      <h2>Local means showing up for more than the job.</h2>
      <p>For Breast Cancer Awareness Month, Dave and the team donated a full-house window cleaning to a local survivor through the Andrew Weishar Foundation. Breast cancer has affected members of the leadership team and their families.</p>
      <p>The team supports the foundation’s pay-it-forward mission and the Chicago families it serves.</p>
      <div class="community-links">
        <a class="button button--light" href="https://www.weish4ever.org/" target="_blank" rel="noopener noreferrer">Visit Weish4Ever <span aria-hidden="true">↗</span></a>
        <a class="text-link text-link--light" href={`${site.officialPage}about/giving-back`}>Read the FISH giving-back story <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="community-story-photo" data-reveal>
      <img src="/images/jobs/3772.webp" width="174" height="310" alt="Members of the local FISH franchise gathered for a community event" loading="lazy" decoding="async" />
      <figcaption>Supporting local families through Weish4Ever.</figcaption>
    </figure>
  </section>

  <section class="leader-section section section--mist">
    <div class="leader-portrait" data-reveal>
      <img src="/images/dave-weishar.webp" width="288" height="214" alt="Dave Weishar, owner of the local FISH Window Cleaning franchise" loading="lazy" decoding="async" />
      <div><strong>Dave Weishar</strong><span>Local owner</span></div>
    </div>
    <div class="leader-copy" data-reveal>
      <h2>Meet the guy behind the red vans.</h2>
      <p>Dave leads the business with local partners and an operations team. Your quote and service stay with the same local company from the first call through the finished job.</p>
      <p>The crew arrives in FISH uniforms, follows franchise service standards, and treats the place like somebody has to live or work there—because somebody does.</p>
      <a class="text-link" href={site.phoneHref} data-track="phone_click" data-location="team-owner">Give the crew a call at {site.phoneDisplay} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="crew-work section" aria-labelledby="crew-work-heading">
    <div class="section-heading" data-reveal>
      <h2 id="crew-work-heading">Ladders up. Squeegees out.</h2>
    </div>
    <div class="crew-work-grid">
      <figure class="crew-work-grid__home" data-reveal>
        <img src="/images/jobs/4312.webp" width="530" height="720" alt="Local FISH technician cleaning second-story windows on a brick home" loading="lazy" decoding="async" />
        <figcaption><strong>Residential work</strong><span>Upper-story windows</span></figcaption>
      </figure>
      <figure data-reveal>
        <img src="/images/jobs/4542.webp" width="576" height="720" alt="Local FISH technician cleaning a storefront entrance" loading="lazy" decoding="async" />
        <figcaption><strong>Commercial work</strong><span>Storefront glass and entries</span></figcaption>
      </figure>
      <figure data-reveal>
        <img src="/images/jobs/4260.webp" width="476" height="720" alt="Local FISH technician cleaning an exterior coach light" loading="lazy" decoding="async" />
        <figcaption><strong>Exterior details</strong><span>Coach lights and finishing work</span></figcaption>
      </figure>
      <figure class="crew-work-grid__wide" data-reveal>
        <img src="/images/jobs/4305.webp" width="720" height="567" alt="Two local FISH Window Cleaning vans parked on a leafy suburban street" loading="lazy" decoding="async" />
        <figcaption><strong>On the road</strong><span>Serving homes and businesses</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="team-standards section">
    <div class="team-standards-intro" data-reveal>
      <h2>Da crew code.</h2>
    </div>
    <ol class="team-standards-list">
      <li data-reveal><span>01</span><div><h3>Show up sharp</h3><p>Uniforms and branded vehicles make it clear who is at the door.</p></div></li>
      <li data-reveal><span>02</span><div><h3>Treat the place right</h3><p>Shoe covers, protective pads, and careful cleanup help protect the property.</p></div></li>
      <li data-reveal><span>03</span><div><h3>Stand behind the shine</h3><p>Residential visits and commercial routes stay with the same local business.</p></div></li>
    </ol>
  </section>

  <EstimateBand source="team-close" heading="Put da local crew on it." />
</BaseLayout>
