---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateBand from '../components/EstimateBand.astro';
import CustomerLogoStrip from '../components/CustomerLogoStrip.astro';
import { estimateLink, googleProfile, site } from '../data/site';

const faqs = [
  ['Do you clean homes and downtown businesses?', 'Yes. The team cleans residential windows as well as storefronts, offices, restaurants, and other commercial properties.'],
  ['How do you handle older or divided-light windows?', 'We confirm the window type, condition, and access during the estimate, then recommend the appropriate method.'],
  ['Can you work around business hours?', 'Yes. Share the hours and access requirements during the estimate so the local team can confirm a workable schedule.'],
];
---

<BaseLayout
  title="Hinsdale Window Cleaning | Local FISH Window Cleaning Team"
  description="Residential and commercial window cleaning for Hinsdale homes, downtown storefronts, and local businesses from a locally owned FISH team."
  canonicalPath="/hinsdale/"
>
  <section class="hero">
    <div class="hero-copy">
      <h1>The glass is different here.</h1>
      <p class="hero-lede">Older divided panes. Tall entries. Downtown storefronts. This local FISH team estimates the property in front of us and cleans it carefully.</p>
      <div class="button-row">
        <a class="button" href={estimateLink('home-hero')} data-track="estimate_click" data-location="home-hero">Request a free estimate</a>
        <a class="button button--outline" href={site.phoneHref} data-track="phone_click" data-location="home-hero">Call {site.phoneDisplay}</a>
      </div>
    </div>
    <figure class="hero-photo hero-compare" data-compare style="--split: 48%;">
      <img class="compare-clean" src="/images/jobs/4305.webp" srcset="/images/jobs/4305-520.webp 520w, /images/jobs/4305.webp 720w" sizes="(max-width: 860px) 100vw, 48vw" width="720" height="567" alt="Two red FISH Window Cleaning vans parked on a tree-lined Chicago suburban street" fetchpriority="high" decoding="async" />
      <div class="compare-dirty" aria-hidden="true">
        <img src="/images/jobs/4305.webp" srcset="/images/jobs/4305-520.webp 520w, /images/jobs/4305.webp 720w" sizes="(max-width: 860px) 100vw, 48vw" width="720" height="567" alt="" decoding="async" />
      </div>
      <span class="compare-label compare-label--dirty" aria-hidden="true"><b>Dirty</b><small>glass</small></span>
      <span class="compare-label compare-label--clean" aria-hidden="true"><b>Clean</b><small>glass</small></span>
      <p class="compare-instruction" aria-hidden="true">Slide to compare</p>
      <div class="compare-divider" aria-hidden="true">
        <span class="compare-handle">
          <svg viewBox="0 0 32 20" role="img" aria-label="Drag handle">
            <path d="M12 4 6 10l6 6M20 4l6 6-6 6" />
          </svg>
        </span>
      </div>
      <label class="compare-control">
        <span class="sr-only">Slide left or right to compare dirty glass with clean glass.</span>
        <input type="range" min="8" max="92" value="48" aria-label="Compare dirty glass with clean glass" />
      </label>
    </figure>
  </section>

  <section class="path-section section" aria-labelledby="choose-path">
    <div class="section-heading" data-reveal>
      <h2 id="choose-path">For the house. For the storefront.</h2>
    </div>
    <div class="path-grid">
      <a class="path-panel path-panel--home" href="/hinsdale/residential-window-cleaning/" data-reveal>
        <img src="/images/jobs/4312.webp" width="530" height="720" alt="Local FISH technician cleaning upper-story windows on a brick Chicago-area home" loading="lazy" decoding="async" />
        <div>
          <h3>Residential window cleaning</h3>
          <span>Interior and exterior glass, screens, tracks, divided panes, and hard-to-reach windows.</span>
          <strong>See residential service <b aria-hidden="true">→</b></strong>
        </div>
      </a>
      <a class="path-panel path-panel--business" href="/hinsdale/commercial-window-cleaning/" data-reveal>
        <img src="/images/jobs/4486.webp" width="587" height="720" alt="Red FISH van outside a Chicago-area commercial window cleaning job in winter" loading="lazy" decoding="async" />
        <div>
          <h3>Commercial window cleaning</h3>
          <span>Storefronts, offices, restaurants, and recurring service built around business hours.</span>
          <strong>See commercial service <b aria-hidden="true">→</b></strong>
        </div>
      </a>
    </div>
    <div class="more-services" data-reveal>
      <a href="/hinsdale/gutter-cleaning/"><strong>Gutter cleaning</strong><span>After leaf drop. Before the first freeze.</span><b aria-hidden="true">→</b></a>
      <a href="/hinsdale/pressure-washing/"><strong>Pressure washing</strong><span>Approved exterior surfaces</span><b aria-hidden="true">→</b></a>
    </div>
  </section>

  <section id="hinsdale-properties" class="local-proof section section--mist">
    <div class="local-proof__copy" data-reveal>
      <h2>Hinsdale homes have character.</h2>
      <p>An older divided-light window is not a broad modern pane. Storms, screens, landscaping, and access all change the work. We confirm the method at the estimate.</p>
      <a class="text-link" href="/hinsdale/residential-window-cleaning/">See residential window cleaning <span aria-hidden="true">→</span></a>
    </div>
    <figure class="local-proof__media" data-reveal>
      <img src="/images/local/downtown-hinsdale.webp" width="1400" height="813" alt="Historic storefronts and mature trees in downtown Hinsdale" loading="lazy" decoding="async" />
      <figcaption>Washington Street, downtown Hinsdale · <a href="https://commons.wikimedia.org/wiki/File:Downtown_Hinsdale_Block.JPG" target="_blank" rel="noopener noreferrer" aria-label="Photo by Teemu08, licensed CC BY-SA 3.0">Photo: Teemu08 / CC</a></figcaption>
    </figure>
    <aside class="local-proof__note" data-reveal>
      <strong>A detail locals know.</strong>
      <p>Hinsdale architect R. Harold Zook used spiderweb and V-shaped windows in his homes. The glass has always been part of the architecture here.</p>
      <a href="https://www.hinsdalehistory.org/zook-home-and-studio" target="_blank" rel="noopener noreferrer">See the Zook Home &amp; Studio <span aria-hidden="true">↗</span></a>
    </aside>
  </section>

  <CustomerLogoStrip />

  <section id="local-work" class="work-section section">
    <div class="section-heading" data-reveal>
      <h2>Work from the local team.</h2>
    </div>
    <div class="work-grid">
      <figure class="work-tall" data-reveal><img src="/images/jobs/4260.webp" width="476" height="720" alt="FISH professional cleaning an exterior coach light on a brick home" loading="lazy" decoding="async" /><figcaption>Exterior detail care</figcaption></figure>
      <figure data-reveal><img src="/images/jobs/4542.webp" width="576" height="720" alt="FISH professional cleaning a local storefront entrance" loading="lazy" decoding="async" /><figcaption>Commercial route work</figcaption></figure>
      <figure data-reveal><img src="/images/jobs/4503.webp" width="720" height="604" alt="Before and after photographs of a gutter cleaned by the local FISH team" loading="lazy" decoding="async" /><figcaption>Gutter cleaning</figcaption></figure>
      <figure class="work-wide" data-reveal><img src="/images/jobs/window-squeegee-closeup.webp" width="2048" height="1365" alt="FISH professional drawing a squeegee across soapy window glass" loading="lazy" /><figcaption>Window cleaning</figcaption></figure>
    </div>
  </section>

  <section class="owner-section section">
    <div class="owner-photo" data-reveal>
      <img src="/images/dave-weishar.webp" width="288" height="214" alt="Dave Weishar, owner of the local FISH Window Cleaning franchise" loading="lazy" decoding="async" />
      <span>Dave Weishar<br />Local owner</span>
    </div>
    <div class="owner-copy" data-reveal>
      <h2>Locally owned.</h2>
      <p>Your estimate and service stay with this locally owned FISH franchise—not a lead broker.</p>
      <div class="owner-links">
        <a class="text-link" href="/team/">Meet the local team <span aria-hidden="true">→</span></a>
        <a class="quiet-link" href={googleProfile.url} target="_blank" rel="noopener noreferrer" data-track="google_reviews_click" data-location="home-owner">Google reviews <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section id="faq" class="faq-section faq-section--home section">
    <div class="section-heading" data-reveal>
      <h2>Questions.</h2>
    </div>
    <div class="faq-list">
      {faqs.map(([question, answer]) => (
        <details data-reveal>
          <summary>{question}<span aria-hidden="true">+</span></summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <EstimateBand source="home-close" heading="Request a free estimate." />
</BaseLayout>
