---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateBand from '../components/EstimateBand.astro';
import CustomerLogoStrip from '../components/CustomerLogoStrip.astro';
import { estimateLink, googleProfile, site } from '../data/site';

const faqs = [
  ['Do you clean both homes and businesses?', 'Yes. The team cleans homes, storefronts, offices, restaurants, and other commercial properties.'],
  ['Can you work with older or divided-light windows?', 'Yes. Show us the window type during the estimate so we can confirm the right method and access.'],
  ['Can you schedule around downtown business hours?', 'Yes. Share your hours and access needs during the estimate.'],
  ['Do you only serve Hinsdale?', 'No. The same franchise serves nearby communities in its official territory.'],
];
---

<BaseLayout
  title="Hinsdale Window Cleaning | Local FISH Window Cleaning Team"
  description="Residential and commercial window cleaning for Hinsdale homes, downtown storefronts, and local businesses from a locally owned FISH team."
  canonicalPath="/hinsdale/"
>
  <section class="hero">
    <div class="hero-copy">
      <h1>Window cleaning that fits a Hinsdale home.</h1>
      <p class="hero-lede">From divided-light windows in Robbins Park to tall entries and broad panes in The Woodlands, the estimate starts with the property you actually have.</p>
      <div class="button-row">
        <a class="button" href={estimateLink('home-hero')} data-track="estimate_click" data-location="home-hero">Request a free estimate</a>
        <a class="button button--outline" href={site.phoneHref} data-track="phone_click" data-location="home-hero">Call {site.phoneDisplay}</a>
      </div>
    </div>
    <figure class="hero-photo hero-compare" data-compare style="--split: 48%;">
      <img class="compare-clean" src="/images/jobs/4305.jpg" width="720" height="567" alt="Two red FISH Window Cleaning vans parked on a tree-lined Chicago suburban street" />
      <div class="compare-dirty" aria-hidden="true">
        <img src="/images/jobs/4305.jpg" width="720" height="567" alt="" />
      </div>
      <span class="compare-label compare-label--dirty" aria-hidden="true"><b>Dirty</b><small>glass</small></span>
      <span class="compare-label compare-label--clean" aria-hidden="true"><b>Clean</b><small>glass</small></span>
      <p class="compare-instruction" aria-hidden="true">Slide to compare</p>
      <div class="compare-divider" aria-hidden="true">
        <span class="compare-handle">
          <svg viewBox="0 0 32 20" role="img" aria-label="Drag handle">
            <path d="M12 4 6 10l6 6M20 4l6 6-6 6" />
          </svg>
        </span>
      </div>
      <label class="compare-control">
        <span class="sr-only">Slide left or right to compare dirty glass with clean glass.</span>
        <input type="range" min="8" max="92" value="48" aria-label="Compare dirty glass with clean glass" />
      </label>
    </figure>
  </section>

  <section class="path-section section" aria-labelledby="choose-path">
    <div class="section-heading" data-reveal>
      <h2 id="choose-path">Homes and businesses.</h2>
    </div>
    <div class="path-grid">
      <a class="path-panel path-panel--home" href="/hinsdale/residential-window-cleaning/" data-reveal>
        <img src="/images/jobs/4312.jpg" width="530" height="720" alt="Local FISH technician cleaning upper-story windows on a brick Chicago-area home" loading="lazy" />
        <div>
          <h3>Residential window cleaning</h3>
          <span>Interior and exterior glass, screens, tracks, divided panes, and hard-to-reach windows.</span>
          <strong>See residential service <b aria-hidden="true">→</b></strong>
        </div>
      </a>
      <a class="path-panel path-panel--business" href="/hinsdale/commercial-window-cleaning/" data-reveal>
        <img src="/images/jobs/4486.jpg" width="587" height="720" alt="Red FISH van outside a Chicago-area commercial window cleaning job in winter" loading="lazy" />
        <div>
          <h3>Commercial window cleaning</h3>
          <span>Storefronts, offices, restaurants, and recurring service built around business hours.</span>
          <strong>See commercial service <b aria-hidden="true">→</b></strong>
        </div>
      </a>
    </div>
    <div class="more-services" data-reveal>
      <a href="/hinsdale/gutter-cleaning/"><strong>Gutter cleaning</strong><span>Mature trees + heavy leaf drop</span><b aria-hidden="true">→</b></a>
      <a href="/hinsdale/pressure-washing/"><strong>Pressure washing</strong><span>Approved exterior surfaces</span><b aria-hidden="true">→</b></a>
    </div>
  </section>

  <section id="hinsdale-properties" class="local-proof section section--mist">
    <div class="local-proof__heading" data-reveal>
      <h2>What changes the estimate.</h2>
      <p>Divided panes, tall entries, tree cover, landscaping, and business hours.</p>
    </div>
    <figure class="local-proof__media" data-reveal>
      <img src="/images/local/downtown-hinsdale.jpg" width="3648" height="2118" alt="Historic storefronts and mature trees in downtown Hinsdale" loading="lazy" />
      <figcaption>Downtown, near Washington Street · <a href="https://commons.wikimedia.org/wiki/File:Downtown_Hinsdale_Block.JPG" target="_blank" rel="noopener noreferrer" aria-label="Photo by Teemu08, licensed CC BY-SA 3.0">Photo: Teemu08 / CC</a></figcaption>
    </figure>
  </section>

  <CustomerLogoStrip />

  <section id="local-work" class="work-section section">
    <div class="section-heading" data-reveal>
      <h2>Recent local work.</h2>
    </div>
    <div class="work-grid">
      <figure class="work-tall" data-reveal><img src="/images/jobs/4260.jpg" width="476" height="720" alt="FISH professional cleaning an exterior coach light on a brick home" loading="lazy" /><figcaption>Exterior detail care</figcaption></figure>
      <figure data-reveal><img src="/images/jobs/4542.jpg" width="576" height="720" alt="FISH professional cleaning a local storefront entrance" loading="lazy" /><figcaption>Commercial route work</figcaption></figure>
      <figure data-reveal><img src="/images/jobs/4503.jpg" width="720" height="604" alt="Before and after photographs of a gutter cleaned by the local FISH team" loading="lazy" /><figcaption>Gutter cleaning</figcaption></figure>
      <figure class="work-wide" data-reveal><img src="/images/jobs/window-squeegee-closeup.webp" width="2048" height="1365" alt="FISH professional drawing a squeegee across soapy window glass" loading="lazy" /><figcaption>Window cleaning</figcaption></figure>
    </div>
  </section>

  <section class="owner-section section">
    <div class="owner-photo" data-reveal>
      <img src="/images/dave-weishar.jpg" width="288" height="214" alt="Dave Weishar, owner of the local FISH Window Cleaning franchise" loading="lazy" />
      <span>Dave Weishar<br />Local owner</span>
    </div>
    <div class="owner-copy" data-reveal>
      <h2>Locally owned.</h2>
      <p>Your estimate and service stay with this locally owned FISH franchise—not a lead broker.</p>
      <div class="owner-links">
        <a class="text-link" href="/team/">Meet the local team <span aria-hidden="true">→</span></a>
        <a class="quiet-link" href={googleProfile.url} target="_blank" rel="noopener noreferrer" data-track="google_reviews_click" data-location="home-owner">Google reviews <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section id="faq" class="faq-section faq-section--home section">
    <div class="section-heading" data-reveal>
      <h2>Questions.</h2>
    </div>
    <div class="faq-list">
      {faqs.map(([question, answer]) => (
        <details data-reveal>
          <summary>{question}<span aria-hidden="true">+</span></summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <EstimateBand source="home-close" heading="Request a free estimate." />
</BaseLayout>
