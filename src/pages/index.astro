---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateBand from '../components/EstimateBand.astro';
import CustomerLogoStrip from '../components/CustomerLogoStrip.astro';
import { estimateLink, googleProfile, site } from '../data/site';
import { areas } from '../data/content';

const faqs = [
  ['Do you clean both homes and businesses?', 'Yes. The local team serves residential properties as well as storefronts, offices, restaurants, and other commercial properties.'],
  ['What areas does this local team serve?', 'The official territory includes Hinsdale, Oak Brook, Burr Ridge, Clarendon Hills, Downers Grove, La Grange, Oak Lawn, Bridgeview, Hickory Hills, Oak Forest, Midlothian, and Flossmoor.'],
  ['Can I request gutter cleaning or pressure washing too?', 'Yes. The local franchise offers window cleaning plus approved exterior services including gutter cleaning, pressure washing, awning cleaning, and exterior light-fixture cleaning. Availability depends on the property and season.'],
];
---

<BaseLayout
  title="Local Window Cleaning | Chicago’s Western & Southern Suburbs"
  description="Professional residential and commercial window cleaning from a locally owned FISH franchise serving Hinsdale and Chicago’s western and southern suburbs."
>
  <section class="hero">
    <div class="hero-copy">
      <h1>A clearer home starts with a local team you know.</h1>
      <p class="location-line">Hinsdale + Chicago’s western and southern suburbs</p>
      <p class="hero-lede">Professional window cleaning and exterior care from a locally owned FISH franchise.</p>
      <div class="button-row">
        <a class="button" href={estimateLink('home-hero')} data-track="estimate_click" data-location="home-hero">Request a free estimate</a>
        <a class="button button--outline" href={site.phoneHref} data-track="phone_click" data-location="home-hero">Call {site.phoneDisplay}</a>
      </div>
    </div>
    <figure class="hero-photo hero-compare" data-compare style="--split: 48%;">
      <img class="compare-clean" src="/images/jobs/4305.jpg" width="720" height="567" alt="Two red FISH Window Cleaning vans parked on a tree-lined Chicago suburban street" />
      <div class="compare-dirty" aria-hidden="true">
        <img src="/images/jobs/4305.jpg" width="720" height="567" alt="" />
      </div>
      <span class="compare-label compare-label--dirty" aria-hidden="true">Everyday grime</span>
      <span class="compare-label compare-label--clean" aria-hidden="true">Clear view</span>
      <p class="compare-instruction" aria-hidden="true">Drag to clear the view</p>
      <div class="compare-divider" aria-hidden="true">
        <span class="compare-handle">
          <svg viewBox="0 0 32 20" role="img" aria-label="Drag handle">
            <path d="M12 4 6 10l6 6M20 4l6 6-6 6" />
          </svg>
        </span>
      </div>
      <label class="compare-control">
        <span class="sr-only">Drag left or right to compare an illustrative dirty-glass effect with the clear local route photo.</span>
        <input type="range" min="8" max="92" value="48" aria-label="Dirty and clean view comparison" />
      </label>
      <figcaption><span>On the route</span> Chicago’s western + southern suburbs</figcaption>
    </figure>
  </section>

  <section class="proof-rail" aria-label="Why local customers choose this team">
    <p><strong>Locally owned</strong></p>
    <p><strong>Uniformed professionals</strong></p>
    <p><strong>Background checked</strong></p>
    <p><strong>Homes + businesses</strong></p>
  </section>

  <section class="chicago-callout" data-reveal>
    <p class="score-copy">Da windows. Da gutters. Da local crew.</p>
    <a href={estimateLink('home-chicago-strip')} data-track="estimate_click" data-location="home-chicago-strip">Get the house game-day ready <span aria-hidden="true">→</span></a>
  </section>

  <section class="path-section section" aria-labelledby="choose-path">
    <div class="section-heading" data-reveal>
      <h2 id="choose-path">What can we make clearer?</h2>
      <p>Homes and businesses need different kinds of care. Start with the path that sounds like you.</p>
    </div>
    <div class="path-grid">
      <a class="path-panel path-panel--home" href="/services/residential-window-cleaning/" data-reveal>
        <img src="/images/jobs/4312.jpg" width="530" height="720" alt="Local FISH technician cleaning upper-story windows on a brick Chicago-area home" loading="lazy" />
        <div>
          <h3>Residential window cleaning</h3>
          <span>Interior, exterior, screens, tracks, and the details that make a room feel brighter.</span>
          <strong>See residential service <b aria-hidden="true">→</b></strong>
        </div>
      </a>
      <a class="path-panel path-panel--business" href="/services/commercial-window-cleaning/" data-reveal>
        <img src="/images/jobs/4486.jpg" width="587" height="720" alt="Red FISH van outside a Chicago-area commercial window cleaning job in winter" loading="lazy" />
        <div>
          <h3>Commercial window cleaning</h3>
          <span>Storefronts, offices, restaurants, and recurring schedules built around your customers.</span>
          <strong>See commercial service <b aria-hidden="true">→</b></strong>
        </div>
      </a>
    </div>
    <div class="more-services" data-reveal>
      <a href="/services/gutter-cleaning/"><strong>Gutter cleaning</strong><span>Seasonal debris + local leaf drop</span><b aria-hidden="true">→</b></a>
      <a href="/services/pressure-washing/"><strong>Pressure washing</strong><span>Approved exterior surfaces</span><b aria-hidden="true">→</b></a>
      <a href="/campaigns/fall-exterior-cleaning/"><strong>Fall exterior cleaning</strong><span>Windows + gutters + exterior details</span><b aria-hidden="true">→</b></a>
    </div>
  </section>

  <CustomerLogoStrip />

  <section class="process-section section section--ink">
    <div class="section-heading section-heading--light" data-reveal>
      <h2>Four steps. No runaround.</h2>
    </div>
    <ol class="process-list">
      <li data-reveal><span>01</span><h3>Tell us about the property</h3><p>Use the official estimate form or call the local number.</p></li>
      <li data-reveal><span>02</span><h3>Confirm the scope</h3><p>The team reviews what needs cleaning and prepares the estimate.</p></li>
      <li data-reveal><span>03</span><h3>Choose the timing</h3><p>Residential visit, storefront route, or recurring business schedule.</p></li>
      <li data-reveal><span>04</span><h3>See the difference</h3><p>A professional clean from the same local operation you contacted.</p></li>
    </ol>
  </section>

  <section id="local-work" class="work-section section">
    <div class="section-heading" data-reveal>
      <h2>Real work from the local franchise.</h2>
    </div>
    <div class="work-grid">
      <figure class="work-tall" data-reveal><img src="/images/jobs/4260.jpg" width="476" height="720" alt="FISH professional cleaning an exterior coach light on a brick home" loading="lazy" /><figcaption>Exterior detail care</figcaption></figure>
      <figure data-reveal><img src="/images/jobs/4542.jpg" width="576" height="720" alt="FISH professional cleaning a local storefront entrance" loading="lazy" /><figcaption>Commercial route work</figcaption></figure>
      <figure data-reveal><img src="/images/jobs/4503.jpg" width="720" height="604" alt="Before and after photographs of a gutter cleaned by the local FISH team" loading="lazy" /><figcaption>Gutter cleaning</figcaption></figure>
      <figure class="work-wide" data-reveal><img src="/images/jobs/window-squeegee-closeup.webp" width="2048" height="1365" alt="FISH professional drawing a squeegee across soapy window glass" loading="lazy" /><figcaption>Window cleaning</figcaption></figure>
    </div>
  </section>

  <section class="owner-section section">
    <div class="owner-photo" data-reveal>
      <img src="/images/dave-weishar.jpg" width="288" height="214" alt="Dave Weishar, owner of the local FISH Window Cleaning franchise" loading="lazy" />
      <span>Dave Weishar<br />Local owner</span>
    </div>
    <div class="owner-copy" data-reveal>
      <h2>National standards. Local accountability.</h2>
      <p>This is a locally owned and operated FISH franchise—not a lead broker. Your call, estimate, and service stay with the local business and crew serving Chicago’s western and southern suburbs.</p>
      <div class="owner-links">
        <a class="text-link" href="/team/">Meet the local team <span aria-hidden="true">→</span></a>
        <a class="quiet-link" href={googleProfile.url} target="_blank" rel="noopener noreferrer" data-track="google_reviews_click" data-location="home-owner">Google reviews <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section id="service-areas" class="route-section section">
    <div class="route-intro" data-reveal>
      <h2>West of the Loop. South of the Loop. Right in the neighborhood.</h2>
      <p>The territory spans established western and southern suburbs, with Hinsdale as the first local content hub.</p>
      <a class="text-link" href="/service-areas/hinsdale-il/">Explore the Hinsdale page <span aria-hidden="true">→</span></a>
    </div>
    <div class="route-board" aria-label="Official service area towns" data-reveal>
      {site.towns.map((town, index) => {
        const area = areas.find((item) => item.name === town);
        return <div><span>{String(index + 1).padStart(2, '0')}</span>{area ? <a href={`/service-areas/${area.slug}/`}><strong>{town}</strong></a> : <strong>{town}</strong>}<small>IL</small></div>;
      })}
    </div>
  </section>

  <section class="faq-section section">
    <div class="section-heading" data-reveal>
      <h2>Straight answers before you call.</h2>
    </div>
    <div class="faq-list">
      {faqs.map(([question, answer]) => (
        <details data-reveal>
          <summary>{question}<span aria-hidden="true">+</span></summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <EstimateBand source="home-close" heading="Let’s get the glass clean before kickoff." />
</BaseLayout>
