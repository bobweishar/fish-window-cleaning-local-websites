---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateBand from '../components/EstimateBand.astro';
import { estimateLink, googleProfile, site } from '../data/site';

const services = [
  {
    name: 'Residential windows',
    copy: 'Interior and exterior glass, screens, tracks, and divided panes.',
    href: '/hinsdale/residential-window-cleaning/',
    image: '/images/jobs/4312.webp',
    width: 530,
    height: 720,
    alt: 'FISH technician cleaning upper-story windows on a brick Chicago-area home',
  },
  {
    name: 'Commercial windows',
    copy: 'Storefronts, offices, restaurants, and recurring routes.',
    href: '/hinsdale/commercial-window-cleaning/',
    image: '/images/jobs/4542.webp',
    width: 576,
    height: 720,
    alt: 'FISH technician cleaning a local storefront entrance',
  },
  {
    name: 'Gutter cleaning',
    copy: 'Leaves and buildup cleared before they become a problem.',
    href: '/hinsdale/gutter-cleaning/',
    image: '/images/hinsdale/gutter-dave.webp',
    width: 1200,
    height: 901,
    alt: 'FISH technician clearing leaves and buildup from a nearby gutter',
  },
  {
    name: 'Pressure washing',
    copy: 'Careful cleaning for approved exterior surfaces.',
    href: '/hinsdale/pressure-washing/',
    image: '/images/jobs/4066.webp',
    width: 248,
    height: 310,
    alt: 'FISH technician pressure washing a brick entryway',
  },
];
---

<BaseLayout
  title="Hinsdale Window Cleaning | Local FISH Window Cleaning Team"
  description="Residential and commercial window cleaning for Hinsdale homes, downtown storefronts, and local businesses from a locally owned FISH team."
  canonicalPath="/hinsdale/"
>
  <section class="hero">
    <div class="hero-copy">
      <h1>Window cleaning for Hinsdale homes and businesses.</h1>
      <p class="hero-lede">This locally owned and operated FISH Window Cleaning team provides careful, reliable service for homes, storefronts, and offices.</p>
      <div class="button-row">
        <a class="button" href={estimateLink('home-hero')} data-track="estimate_click" data-location="home-hero">Request a free quote</a>
        <a class="button button--outline" href={site.phoneHref} data-track="phone_click" data-location="home-hero">Call {site.phoneDisplay}</a>
      </div>
    </div>
    <figure class="hero-photo hero-compare" data-compare style="--split: 48%;">
      <img class="compare-clean" src="/images/jobs/4305.webp" srcset="/images/jobs/4305-520.webp 520w, /images/jobs/4305.webp 720w" sizes="(max-width: 860px) 100vw, 48vw" width="720" height="567" alt="Two red FISH Window Cleaning vans parked on a tree-lined Chicago suburban street" fetchpriority="high" decoding="async" />
      <div class="compare-dirty" aria-hidden="true">
        <img src="/images/jobs/4305.webp" srcset="/images/jobs/4305-520.webp 520w, /images/jobs/4305.webp 720w" sizes="(max-width: 860px) 100vw, 48vw" width="720" height="567" alt="" decoding="async" />
      </div>
      <span class="compare-label compare-label--dirty" aria-hidden="true"><b>Dirty</b><small>glass</small></span>
      <span class="compare-label compare-label--clean" aria-hidden="true"><b>Clean</b><small>glass</small></span>
      <p class="compare-instruction" aria-hidden="true">Slide to compare</p>
      <div class="compare-divider" aria-hidden="true">
        <span class="compare-handle">
          <svg viewBox="0 0 32 20" role="img" aria-label="Drag handle">
            <path d="M12 4 6 10l6 6M20 4l6 6-6 6" />
          </svg>
        </span>
      </div>
      <label class="compare-control">
        <span class="sr-only">Slide left or right to compare dirty glass with clean glass.</span>
        <input type="range" min="8" max="92" value="48" aria-label="Compare dirty glass with clean glass" />
      </label>
    </figure>
  </section>

  <section class="path-section section" aria-labelledby="choose-path">
    <div class="section-heading" data-reveal>
      <h2 id="choose-path">For the house. For the storefront. For the office.</h2>
      <p>Window cleaning, gutters, and pressure washing from one local crew.</p>
    </div>
    <div class="service-rail" data-reveal>
      {services.map((service) => (
        <a class="service-tile" href={service.href}>
          <img src={service.image} width={service.width} height={service.height} alt={service.alt} loading="lazy" decoding="async" />
          <div>
            <h3>{service.name}</h3>
            <p>{service.copy}</p>
            <span>See service <b aria-hidden="true">→</b></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section id="hinsdale-properties" class="local-proof section section--mist">
    <div class="local-proof__copy" data-reveal>
      <h2>Hinsdale homes have character.</h2>
      <p>We take great care with the things that make Hinsdale homes unique and special. Storms, screens, landscaping, and access all change the work. We confirm the method when we prepare your quote.</p>
      <a class="text-link" href="/hinsdale/residential-window-cleaning/">See residential window cleaning <span aria-hidden="true">→</span></a>
    </div>
    <figure class="local-proof__media" data-reveal>
      <img src="/images/hinsdale/condo.webp" width="1600" height="1200" alt="Hinsdale condominium building with large multi-pane windows served by the local team" loading="lazy" decoding="async" />
    </figure>
  </section>

  <section id="hinsdale-businesses" class="hinsdale-businesses section" aria-labelledby="hinsdale-businesses-heading">
    <div class="section-heading" data-reveal>
      <h2 id="hinsdale-businesses-heading">A few Hinsdale businesses we clean.</h2>
      <p>The team serves more than a dozen commercial clients in town, from storefronts to community spaces.</p>
    </div>
    <div class="business-photo-strip">
      <figure data-reveal>
        <img src="/images/hinsdale/browning.webp" width="1400" height="523" alt="Browning and Sons storefront in downtown Hinsdale" loading="lazy" decoding="async" />
        <figcaption>Browning &amp; Sons</figcaption>
      </figure>
      <figure data-reveal>
        <img src="/images/hinsdale/the-pearl.webp" width="1400" height="695" alt="The Pearl of Hinsdale community building" loading="lazy" decoding="async" />
        <figcaption>The Pearl of Hinsdale</figcaption>
      </figure>
      <figure data-reveal>
        <img src="/images/hinsdale/pages.webp" width="900" height="811" alt="Page's Restaurant storefront in downtown Hinsdale" loading="lazy" decoding="async" />
        <figcaption>Page's Restaurant</figcaption>
      </figure>
    </div>
  </section>

  <section class="home-team section section--mist">
    <div class="home-team__photo" data-reveal>
      <img src="/images/jobs/3800.webp" width="310" height="236" alt="Members of the local FISH Window Cleaning crew together in their red uniforms" loading="lazy" decoding="async" />
    </div>
    <div class="home-team__copy" data-reveal>
      <h2>The local team behind the work.</h2>
      <p>The same locally owned FISH team answers the phone, prepares the quote, and completes the work.</p>
      <div class="home-team__links">
        <a class="text-link" href="/team/">Meet the local team <span aria-hidden="true">→</span></a>
        <a class="quiet-link" href={googleProfile.url} target="_blank" rel="noopener noreferrer" data-track="google_reviews_click" data-location="home-owner">Google reviews <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <EstimateBand source="home-close" heading="Request a free quote." />
</BaseLayout>
